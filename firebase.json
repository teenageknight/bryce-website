{
    "hosting": {
        "public": "app/dist",
        "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    },
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "admin-tooling"],
            "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
        }
    ]
}
